{
  "name": "stagehand-for-electron",
  "version": "1.0.0",
  "description": "AI-powered browser automation service for Electron applications using Stagehand",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:cli",
    "build:next": "next build",
    "build:cli": "tsc src/cli/index.ts --outDir dist --target es2020 --module commonjs --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck --resolveJsonModule",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "cli": "node dist/cli/index.js",
    "stagehand-electron": "npm run build:cli && node dist/cli/index.js",
    "agent": "npm run build:cli && node dist/agent/index.js",
    "agent:dev": "tsx src/agent/index.ts",
    "clean": "rm -rf .next dist",
    "reinstall": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "electron",
    "automation",
    "ai",
    "stagehand",
    "cdp",
    "testing",
    "browser-automation",
    "typescript",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@browserbasehq/stagehand": "^3.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.25",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.22",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.6",
    "chalk": "^4.1.2",
    "chrome-remote-interface": "^0.33.3",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.2.15",
    "node-fetch": "^2.7.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "ws": "^8.18.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/stagehand-for-electron.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/stagehand-for-electron/issues"
  },
  "homepage": "https://github.com/your-username/stagehand-for-electron#readme"
}
