            { "type": "check_video", "description": "检查视频流 canvas 展示" }
          ]
        }
      ]
    },
    {
      "id": "step-6",
      "name": "验证视频流 canvas 展示",
      "type": "verify_canvas",
      "action": "确保浏览过程中的视频内容在 canvas 中正确展示",
      "checks": [
        {
          "type": "canvas_exists",
          "selector": "canvas, video",
          "description": "Canvas 或 video 元素存在"
        },
        {
          "type": "canvas_playing",
          "description": "视频正在播放中"
        },
        {
          "type": "no_errors",
          "description": "控制台无视频相关错误"
        }
      ]
    }
  ],
  "expectations": {
    "totalDuration": "estimated:5-15 minutes",
    "browsingBehavior": "模拟真实人类浏览速率（每次操作间隔2-8秒）",
    "videoDisplay": "所有视频内容应在 canvas 中正常展示",
    "loginState": "需要用户已登录或等待用户登录"
  },
  "metadata": {
    "created_at": "2025-02-15",
    "tags": ["xiaohongshu", "food", "browse", "video", "benchmark"],
